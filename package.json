{
  "name": "betabook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deadcode": "knip",
    "deadcode:prod": "knip --production",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "check": "pnpm lint && pnpm format:check && pnpm deadcode && pnpm typecheck && pnpm test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "setup": "node scripts/setup.ts",
    "promote-admin": "node --disable-warning=ExperimentalWarning scripts/promote-admin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@internationalized/date": "3.12.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.8",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tailwindcss": "^1.10.2",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 115",
    "safari 16.4"
  ],
  "packageManager": "pnpm@11.25.0"
}
